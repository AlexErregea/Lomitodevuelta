# ============================================================================
# LomitoDeVuelta — Variables de entorno (plantilla documentada, SIN secretos)
# ----------------------------------------------------------------------------
# Cómo usar: copia este archivo a `apps/web/.env.local` y rellena los valores.
# `.env.local` está en .gitignore: los secretos NUNCA se suben al repo.
#
# Columna "Dónde vive" — cada secreto existe en un solo lugar por entorno:
#   [local]    apps/web/.env.local (tu máquina)
#   [vercel]   Vercel → Project → Settings → Environment Variables
#   [supabase] Supabase → Edge Functions → Secrets (supabase secrets set ...)
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — conexión de la app web                    [local + vercel]
# En local: `pnpm db:start` imprime estos valores.
# En producción: Supabase → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: omite RLS. SOLO código de servidor; jamás NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App                                                   [local + vercel]
# ---------------------------------------------------------------------------
# URL base pública (enlaces de gestión, fichas compartibles, og:image).
APP_BASE_URL=http://localhost:3000

# Secreto (pepper) del HMAC con que se hashean los tokens de gestión de los
# reportes ciudadanos (ADR-0006). Genera uno: `openssl rand -hex 32`.
MANAGE_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Visión / IA (ADR-0003) — costo variable dominante    [local + vercel]
# ---------------------------------------------------------------------------
# Embeddings visuales (Replicate). El modelo concreto se fija en la tabla
# matching_params (embedding_model_version), no aquí.
REPLICATE_API_TOKEN=

# Extracción de atributos con LLM multimodal (Claude).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (ADR-0008)                        [supabase]
# Las usan las Edge Functions; se configuran con `supabase secrets set`.
# Se listan aquí solo como inventario. Guía de obtención: Bloque 7.
# ---------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=          (token permanente de la app de Meta)
# WHATSAPP_PHONE_NUMBER_ID=       (ID del número emisor)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=  (lo inventas tú; Meta lo repite al verificar)
# WHATSAPP_APP_SECRET=            (valida la firma X-Hub-Signature-256)

# ---------------------------------------------------------------------------
# Email fallback — Resend (ADR-0008)                   [supabase]
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Puente DB webhook → Edge Functions (ADR-0002)        [supabase]
# Secreto compartido que autentica los webhooks internos de la base.
# ---------------------------------------------------------------------------
# EDGE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analítica — PostHog (Bloque 6)                       [local + vercel]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
