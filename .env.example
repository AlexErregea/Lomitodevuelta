# ============================================================================
# LomitoDeVuelta — Variables de entorno (plantilla documentada, SIN secretos)
# ----------------------------------------------------------------------------
# Cómo usar: copia este archivo a `apps/web/.env.local` y rellena los valores.
# `.env.local` está en .gitignore: los secretos NUNCA se suben al repo.
#
# Columna "Dónde vive" — cada secreto existe en un solo lugar por entorno:
#   [local]    apps/web/.env.local (tu máquina)
#   [vercel]   Vercel → Project → Settings → Environment Variables
#   [supabase] Supabase → Edge Functions → Secrets (supabase secrets set ...)
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — conexión de la app web                    [local + vercel]
# En local: `pnpm db:start` imprime estos valores.
# En producción: Supabase → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: omite RLS. SOLO código de servidor; jamás NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App                                                   [local + vercel]
# ---------------------------------------------------------------------------
# URL base pública (enlaces de gestión, fichas compartibles, og:image).
APP_BASE_URL=http://localhost:3000

# Secreto (pepper) del HMAC con que se hashean los tokens de gestión de los
# reportes ciudadanos (ADR-0006). Genera uno: `openssl rand -hex 32`.
MANAGE_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Visión / IA (ADR-0003) — costo variable dominante    [local + vercel + supabase]
# (supabase: las usa retry-pending para reintentar inferencias fallidas)
# ---------------------------------------------------------------------------
# Embeddings visuales (Replicate). La VERSIÓN que se persiste con cada vector
# viene de matching_params (embedding_model_version); esta variable elige el
# modelo concreto de Replicate. Default: andreasjansson/clip-features
# (placeholder pre-benchmark, ver docs/benchmark-embeddings.md).
REPLICATE_API_TOKEN=
# REPLICATE_EMBEDDING_MODEL=andreasjansson/clip-features

# Extracción de atributos con LLM multimodal (Claude Haiku por costo, ADR-0003).
ANTHROPIC_API_KEY=
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (ADR-0008)                        [supabase (+vercel opcional)]
# Las usan las Edge Functions; se configuran con `supabase secrets set`.
# ACCESS_TOKEN y PHONE_NUMBER_ID también pueden ponerse en Vercel: habilitan
# el envío INMEDIATO del enlace de gestión al crear el reporte (si faltan,
# retry-pending lo envía en ≤5 min — el sistema funciona igual).
# Guía de obtención: docs/guia-whatsapp-setup.md.
# ---------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=          (token permanente de la app de Meta)
# WHATSAPP_PHONE_NUMBER_ID=       (ID del número emisor)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=  (lo inventas tú; Meta lo repite al verificar)
# WHATSAPP_APP_SECRET=            (valida la firma X-Hub-Signature-256)

# ---------------------------------------------------------------------------
# Email fallback — Resend (ADR-0008)                   [supabase]
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM="LomitoDeVuelta <noreply@lomitodevuelta.com>"

# ---------------------------------------------------------------------------
# Puente DB/cron → Edge Functions (ADR-0002)           [supabase + vault]
# Secreto compartido que autentica las invocaciones internas. Además de
# `supabase secrets set EDGE_WEBHOOK_SECRET=...`, el MISMO valor y las URLs de
# las funciones van a Vault para los triggers y jobs de pg_cron/pg_net
# (migraciones 20260719130000 y 20260722100000):
#   select vault.create_secret('<valor>', 'edge_webhook_secret');
#   select vault.create_secret('https://PROJECT.supabase.co/functions/v1/retry-pending',     'edge_retry_pending_url');
#   select vault.create_secret('https://PROJECT.supabase.co/functions/v1/on-report-created', 'edge_on_report_created_url');
#   select vault.create_secret('https://PROJECT.supabase.co/functions/v1/lifecycle',          'edge_lifecycle_url');
# ---------------------------------------------------------------------------
# EDGE_WEBHOOK_SECRET=

# Las Edge Functions [supabase] comparten secretos con la web: REPLICATE_API_TOKEN,
# ANTHROPIC_API_KEY, WHATSAPP_* y RESEND_* (reintentos, capa 3 proactiva, puente de
# contacto), y MANAGE_TOKEN_PEPPER + APP_BASE_URL (regeneran enlaces de gestión).
# El presupuesto de mensajes y el kill-switch viven en la tabla system_config,
# no en variables de entorno (ADR-0008): edítalos con UPDATE desde Supabase.

# ---------------------------------------------------------------------------
# Analítica — PostHog (Bloque 6)                       [local + vercel]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
